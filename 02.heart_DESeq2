yyx_discrete_colors = function(N){
  hues <- seq(15, 375, length.out = N + 1)
  hues <- hues[-length(hues)]  # Remove the last element to avoid duplicating the first color
  hcl(h = hues, c = 100, l = 65)
}


yyx_judge_significant_diffExpr_q = function(res, signif_condition){
  res_df = as.data.frame(res)
  res_df = res_df[!is.na(res_df$pvalue),]
  res_df = res_df[!is.na(res_df$padj),]
  res_df = res_df[!is.na(res_df$log2FoldChange),]
  res_df = res_df[order(res_df$pvalue),]
#  res_df$gene = rownames(res_df)
  res_df = cbind(data.frame(gene=rownames(res_df)), res_df)
  res_df$significant = yyx_get_subset_rowidxes_q(res_df, signif_condition)
  res_df$diffExpr = ifelse(res_df$significant, ifelse(res_df$log2FoldChange > 0, "Up", "Down"), "NS")
  res_df
}
yyx_judge_significant_diffExpr = function(res, signif_condition){
  yyx_judge_significant_diffExpr_q(res, substitute(signif_condition))
}

# Create the volcano plot
yyx_volcano_plot <- function(res_df, label_top_N = 50, label_text_size = 2, x_lim=NULL){
  res_df$gene = rownames(res_df)
  res_df = res_df[order(-res_df$pvalue),]
  if(is.null(x_lim)){
    x_lim = range(res_df$log2FoldChange, na.rm=TRUE)
  }
  res_df$log2FoldChange[res_df$log2FoldChange > x_lim[2]] = x_lim[2]
  res_df$log2FoldChange[res_df$log2FoldChange < x_lim[1]] = x_lim[1]
  top_df = tail(subset(res_df, diffExpr != "NS"), label_top_N)
  if(!is.data.frame(res_df) || ! "diffExpr" %in% names(res_df)){
    stop("Run res_df = yyx_judge_significant_diffExpr(res, signif_condition) first")
  }
  ggplot(res_df, aes(x=log2FoldChange, y=-log10(pvalue))) +
    geom_point(aes(color=diffExpr), alpha=0.8, size=1.5) +
    geom_text_repel(
      data = top_df,
      aes(label = gene),
      size = label_text_size, 
      box.padding = 0.01, 
      point.padding = 0.01,
      segment.color = "grey50",  # Color of the segment
      segment.size = 0.5,        # Line thickness of the segment
      force = 1                  # Force pushing the text away from the point
    ) +
#    scale_color_manual(values = c("grey", "red")) +
    coord_cartesian(xlim=x_lim) +
    scale_color_manual(values = hsv(c(0.67,0,0), c(0.5,0,0.5), c(1,0.8,1))) +
    labs(#title = "Volcano Plot of DESeq2 Results",
         color = "",
         x = "Log2 Fold Change",
         y = "-Log10 P-value") +
    theme_classic() #+
#    theme(legend.position = "none")  # Optional: remove the legend
}

yyx_plot_counts = function(dds, res_df, topN=100, genes=head(res_df$gene[res_df$diffExpr!="NS"], topN), intgroup="time_factor", sep_char=":", rep_idx_in_rowname=-1, point_size=3, text_size=3, y_lab="Normalized count", x_lab=intgroup, add_trend_line=TRUE, trend_line_color="gray70"){
#  echo(length(genes))
  for(now_gene in genes){
#    echo(now_gene)
    now_DF = plotCounts(dds, gene=now_gene, intgroup=intgroup, returnData=TRUE)
    now_DF = yyx_add_one_column_combine_columns(now_DF, "combined_group", now_DF, intgroup, sep_char=sep_char)
    tmp_split_list = strsplit(rownames(now_DF), "[.]")
    if(!"rep" %in% names(now_DF)){
      now_DF$rep = yyx_get_field_from_strsplit(tmp_split_list, rep_idx_in_rowname)
    }
    shape_levels = levels(factor(now_DF$rep))
    p = ggplot(now_DF) + aes(x=combined_group, y=count) + geom_beeswarm(aes(shape=rep), size=point_size, cex=point_size) + scale_y_log10() + theme_classic() + ggtitle(now_gene) + xlab(x_lab) + ylab(y_lab) + scale_shape_manual(breaks=shape_levels, values=(1:length(shape_levels))-1)
    if(add_trend_line){
      p = p + geom_line(data = now_DF %>% group_by(combined_group) %>% summarize(count=exp(mean(log(count)))) %>% ungroup(), aes(x=combined_group, y=count, group=1), color=trend_line_color)
    }
    print(p)
  }
}
