
options(stringsAsFactors=FALSE)


library(tidyverse)
library(DESeq2)
library(ggrepel)
library(ggbeeswarm)


`%.%` <- function(x,y) paste0(x,y)

join = function(sep, vec, ...) paste(collapse=sep, c(vec, ...))
cat0 = function(...) cat(sep="", ...)

echo_str <- function(x, sep=" =\t", collapse=", ") deparse(substitute(x)) %.% sep %.% join(collapse, x)
echo <- function(x, sep=" =\t", collapse=", ") cat0(deparse(substitute(x)), sep, join(collapse, x), "\n");


yyx_get_field_from_strsplit = function(split_list, idx, default=""){
	sapply(split_list, function(vec){
		if(idx >= 1 && idx <= length(vec)){
			vec[idx]
		}else if(idx <= -1 && idx >= -length(vec)){
			vec[length(vec)+1+idx]
		}else{
			default
		}
	})
}
yyx_join_fields_from_strsplit = function(sep, split_list, idx_from, idx_to, default=""){
	sapply(split_list, function(vec){
		if(idx_from >= 1 && idx_from <= length(vec)){
			# good, do nothing
		}else if(idx_from <= -1 && idx_from >= -length(vec)){
			idx_from = length(vec)+1+idx_from
		}else{
			idx_from = NA
		}
		if(idx_to >= 1 && idx_to <= length(vec)){
			# good, do nothing
		}else if(idx_to <= -1 && idx_to >= -length(vec)){
			idx_to = length(vec)+1+idx_to
		}else{
			idx_to = NA
		}
		
		if(!is.na(idx_from) && !is.na(idx_to) && idx_from <= idx_to){
			join(sep, vec[idx_from:idx_to])
		}else{
			default
		}
	})
}


### ref: http://adv-r.had.co.nz/Computing-on-the-language.html
yyx_get_subset_rowidxes_q = function(DF, condition){
    eval(condition, DF, parent.frame())
}
yyx_get_subset_rowidxes <- function(DF, condition) {
    yyx_get_subset_rowidxes_q(DF, substitute(condition))
}

yyx_subset_DESeq = function(cts, coldata, subset_condition, design){
  idxes = yyx_get_subset_rowidxes_q(coldata, substitute(subset_condition))
  dds <- DESeqDataSetFromMatrix(countData = cts[, idxes], colData = coldata[idxes, ], design = design)
  echo(dim(dds$counts))
  DESeq(dds)
}


yyx_add_one_column_combine_columns = function(new_DF, new_colname, old_DF, old_colnames, sep_char=":"){
  new_DF[[new_colname]] = old_DF[[old_colnames[1]]]
  if(length(old_colnames) > 1){
    for(k in 2:length(old_colnames)){
      new_DF[[new_colname]] = as.character(new_DF[[new_colname]]) %.% sep_char %.% old_DF[[old_colnames[k]]]
    }
  }
  new_DF
}

yyx_plotPCA = function(vst_data, intgroup, ntop=500, shape_by=NULL, txt_label=NULL, dot_size=1.5, sep_char=":"){
  # Extract the matrix of transformed values
  vst_matrix <- assay(vst_data)
  
  if(ntop > nrow(vst_matrix)){
    ntop = nrow(vst_matrix)
  }
  
  # Compute the variance for each gene
  gene_variances <- apply(vst_matrix, 1, var)  # 1 indicates row-wise operation
  
  # Order genes by variance and select the top N
  top_genes_indices <- order(gene_variances, decreasing = TRUE)[1:ntop]
  
  # Subset the vst_data to include only these top variable genes
  vst_matrix <- vst_matrix[top_genes_indices, ]
  
  # Perform PCA using prcomp
  pca_result <- prcomp(t(vst_matrix))
  
  # Calculate percentage of variance explained
  var_explained <- pca_result$sdev^2 / sum(pca_result$sdev^2) * 100
  
  # Create a data frame for plotting
  pc_data <- data.frame(PC1 = pca_result$x[, "PC1"], PC2 = pca_result$x[, "PC2"])
  pc_data = yyx_add_one_column_combine_columns(pc_data, "combined_group", vst_data, intgroup, sep_char=sep_char)
  if(!is.null(shape_by)){
    pc_data = yyx_add_one_column_combine_columns(pc_data, "shape", vst_data, shape_by, sep_char=sep_char)
  }
  if(!is.null(txt_label)){
    pc_data = yyx_add_one_column_combine_columns(pc_data, "label", vst_data, txt_label, sep_char=sep_char)
  }
  
  # Plot using ggplot2
  p = ggplot(pc_data, aes(x = PC1, y = PC2, color = combined_group))
  if(!is.null(shape_by)){
    p = p + geom_point(aes(shape=shape), size = dot_size)
  }else{
    p = p + geom_point(size = dot_size)
  }
  p = p + labs(x="PC1: " %.% round(var_explained[1], 1) %.% "% variance", y="PC2: " %.% round(var_explained[2], 1) %.% "% variance", color=paste(collapse=sep_char, intgroup)) + coord_fixed(ratio = sqrt(sqrt(var_explained[2]/var_explained[1]))) + theme_bw()
  if(!is.null(shape_by)){
    shape_levels = levels(factor(pc_data$shape))
    p = p + labs(shape=paste(collapse=sep_char, shape_by)) + scale_shape_manual(breaks=shape_levels, values=(1:length(shape_levels))-1)
  }
  if(!is.null(txt_label)){
    p = p + geom_text(aes(label = label))
  }
  p
}
