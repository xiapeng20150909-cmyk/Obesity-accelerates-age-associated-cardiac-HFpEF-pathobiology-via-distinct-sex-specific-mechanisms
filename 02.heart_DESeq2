base_dirname = "original"

### DESeq2   # ref: https://www.bioconductor.org/packages/release/bioc/vignettes/DESeq2/inst/doc/DESeq2.html#count-matrix-input

counts_DF = read.csv(base_dirname %.% "/Rsubread_featureCounts/featureCounts_count.20240424.csv")
dim(counts_DF)   # 25239    37

rownames(counts_DF) = counts_DF[,1]
counts_DF = counts_DF[,-1]
dim(counts_DF)   # 25239    36

colnames(counts_DF) = sub("[.]Aligned[.]out[.]bam$", "", colnames(counts_DF))

cts = as.matrix(counts_DF)
dim(cts)   # 25239    36

coldata = data.frame(raw_name = colnames(counts_DF))
tmp_split_list = strsplit(coldata$raw_name, "[.]")
coldata$age = yyx_get_field_from_strsplit(tmp_split_list, 1)
coldata$age = factor(coldata$age, levels=c("AC", "AH", "Y"))
coldata$sex = yyx_get_field_from_strsplit(tmp_split_list, 2)
coldata$sex = factor(coldata$sex, levels=c("F", "M"))
coldata$rep = yyx_get_field_from_strsplit(tmp_split_list, 3)
coldata$tissue = yyx_get_field_from_strsplit(tmp_split_list, 4)
coldata$tissue = factor(coldata$tissue, levels=c("heart"))
dim(coldata)   # 36  5

dds <- DESeqDataSetFromMatrix(countData = cts, colData = coldata, design = ~ age + sex + tissue)
dds
'
class: DESeqDataSet 
dim: 25239 36 
metadata(1): version
assays(1): counts
rownames(25239): Zc3h14 Troap ... Btbd35f26 Btbd35f6
rowData names(0):
colnames(36): AC.F.1.heart ... Y.M.3.heart
colData names(5): raw_name age sex rep tissue
'

smallestGroupSize <- 3
keep <- rowSums(counts(dds) >= 10) >= smallestGroupSize
dds <- dds[keep,]
dds
'
class: DESeqDataSet 
dim: 15188 36 
metadata(1): version
assays(1): counts
rownames(15166): Zc3h14 1810013L24Rik ... Gm42517 Paqr9
rowData names(0):
colnames(36): AC.F.1.heart ... Y.M.3.heart
colData names(5): raw_name age sex rep tissue
'


cts = counts(dds)
dim(cts)   # 15188    36



output_res_df_plot_volcano_counts = function(dds, res, signif_condition, output_prefix, volcano_label_top_N=50, volcano_x_lim=NULL, topN=100, x_lab="Age"){
  res_df = yyx_judge_significant_diffExpr_q(res, substitute(signif_condition))
  echo(dim(res_df))
  echo(sum(res_df$padj < 0.1, na.rm=TRUE))
  print(table(res_df$diffExpr))
  res_df %>% write_tsv(output_prefix %.% ".tsv")
  pdf(output_prefix %.% ".pdf")
  print( yyx_volcano_plot(res_df, label_top_N=volcano_label_top_N, x_lim=volcano_x_lim) )
  yyx_plot_counts(dds, res_df, intgroup=c("age"), rep_idx_in_rowname=-2, topN=topN, x_lab=x_lab)
  dev.off()
  cat("\n")
}


