convert_str_geneIDs_to_symbols = function(str_vec_geneIDs, sep_char="/"){
 tmp_list = strsplit(str_vec_geneIDs, sep_char)
 sapply(tmp_list, function(one_vec){
  tmp_vec = sapply(one_vec, function(one_geneID){
   idx = which(symbol2geneID$ENTREZID == as.integer(one_geneID))
   if(length(idx) > 0){
    return(symbol2geneID$gene[idx[1]])
   }else{
    return(NA)
   }
  })
  paste(collapse=sep_char, tmp_vec)
 })
}
